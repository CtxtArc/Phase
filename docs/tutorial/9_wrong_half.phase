event half_done;
event full_done;

interrupt fn on_dma() @ irq 11 {
    signal half_done;
    signal full_done;
}

extern fn start(lo: write buffer<u16, 64> @RAM -> @DMA,
                hi: write buffer<u16, 64> @RAM -> @DMA);
extern fn process(h: read buffer<u16, 64> @RAM);

fn main() {
    buffer<u16, 128> ring @RAM;
    split ring into lo, hi;
    start(lo, hi);
    wait half_done for lo;
    process(lo);
    move lo -> @DMA;
    wait half_done for hi;   // should be full_done
    process(hi);
    wait full_done for lo;
    join lo, hi into ring;
}
