// Fuzzer finding (seed 27): a buffer declared @DMA inside a loop body went
// out of scope still owned by DMA, and the analyzer accepted it. Fixed in
// the analyzer (block-local scope exit). Must now be rejected.

extern fn flip() -> bool;
extern fn count() -> u32;
extern fn look(x: read buffer<u8, 8> @RAM);
extern fn poke(x: write buffer<u8, 8> @RAM);
extern fn mix(a: read buffer<u8, 8> @RAM, b: write buffer<u8, 8> @RAM);
extern fn cmp(a: read buffer<u8, 8> @RAM, b: read buffer<u8, 8> @RAM);
extern fn start(x: write buffer<u8, 8> @RAM -> @DMA);
extern fn finish(x: buffer<u8, 8> @DMA -> @RAM);
extern fn emit(x: write buffer<u8, 8> @RAM -> @DEVICE);
extern fn kick(x: buffer<u8, 8> @DMA);

fn main() {
    let n1: u32 = 0;
    let l2: u32 = count();
    while n1 < l2 {
        let n3: u32 = 0;
        let l4: u32 = count();
        while n3 < l4 {
            buffer<u8, 8> b5 @DMA;
            buffer<u8, 8> b6 @RAM;
            n3 = n3 + 1;
        }
        n1 = n1 + 1;
    }
    buffer<u8, 8> b7 @RAM;
}
