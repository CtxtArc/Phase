// v2.0 example: a UART driver written entirely in PHASE.
//
// The board's register maps live in devices/mps2_an385.phase: one
// `device type` for the CMSDK APB UART, and an instance of it for each of
// the board's five UARTs. Every access below is checked against that map:
// a misspelled register or field, a write to a read-only register, or a
// value too wide for its field is a compile error, not a silent bug.
//
//   phase build --target=mps2-an385 --run examples/uart_hello.phase
//
// cross-compiles this for the board and runs it on QEMU: the text below
// comes out of the real UART0 data register. A plain host build runs the
// same code against a simulated register block instead.

import "devices/mps2_an385.phase";   // Uart0..Uart4, Timer0, Timer1

// Wait for room in the transmit FIFO, then send one byte.
fn send_byte(c: u32) {
    while volatile_read(Uart0.STATE.TXFULL) == 1 {
    }
    volatile_write(Uart0.DATA, c);
}

fn main() {
    volatile_write(Uart0.BAUDDIV.DIV, 16);  // the slowest legal divisor
    volatile_write(Uart0.CTRL.TX_EN, 1);    // enable the transmitter only

    send_byte(72);   // H
    send_byte(101);  // e
    send_byte(108);  // l
    send_byte(108);  // l
    send_byte(111);  // o
    send_byte(32);   //
    send_byte(102);  // f
    send_byte(114);  // r
    send_byte(111);  // o
    send_byte(109);  // m
    send_byte(32);   //
    send_byte(80);   // P
    send_byte(72);   // H
    send_byte(65);   // A
    send_byte(83);   // S
    send_byte(69);   // E
    send_byte(10);   // newline

    // The FIFO was never overrun: `send_byte` waits for room every time.
    if volatile_read(Uart0.STATE.TXOVR) == 1 {
        send_byte(33);  // !
    }
}
