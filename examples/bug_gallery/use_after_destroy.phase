// Bug gallery #4: using an entity after it has been destroyed.
// Expected: "was destroyed; cannot use as argument"

entity Sample : @RAM {
    value: f32
}

extern fn fir_filter(in_: buffer<Sample, 1024> @RAM,
                      out: buffer<Sample, 1024> @RAM);

fn main() {
    buffer<Sample, 1024> raw @RAM;
    buffer<Sample, 1024> filtered @RAM;

    destroy raw;

    // BUG: raw was just destroyed.
    fir_filter(raw, filtered);
}
