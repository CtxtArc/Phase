// Bug gallery #31: using the whole buffer while it is split. Half of it
// belongs to the DMA engine, so code that takes the whole buffer -- here a
// summary over all 128 samples -- reads a half that is being written.
// Expected: "'ring' is split into lo, hi; join them back first (cannot use as argument to 'summarize')"

extern fn start_circular(lo: write buffer<f32, 64> @RAM -> @DMA,
                         hi: write buffer<f32, 64> @RAM -> @DMA);
extern fn wait_half(h: buffer<f32, 64> @DMA -> @RAM);
extern fn summarize(x: read buffer<f32, 128> @RAM);

fn main() {
    buffer<f32, 128> ring @RAM;
    split ring into lo, hi;
    start_circular(lo, hi);
    wait_half(lo);

    // BUG: hi is still owned by the engine.
    summarize(ring);

    wait_half(hi);
    join lo, hi into ring;
}
