// Bug gallery #22: the classic ping-pong mistake -- restarting the DMA
// capture into the buffer the CPU is about to process. The engine
// overwrites the frame mid-processing: a torn frame, silently.
// Expected: "entity 'ping' is in domain @DMA but 'process' expects @RAM"

extern fn start_capture(dst: write buffer<f32, 128> @RAM -> @DMA);
extern fn process(frame: read buffer<f32, 128> @RAM);

fn wait_capture(b: buffer<f32, 128> @DMA -> @RAM) {
    sync(b);
}

fn main() {
    buffer<f32, 128> ping @RAM;
    buffer<f32, 128> pong @RAM;
    let n: u32 = 0;

    start_capture(ping);
    while n < 6 {
        wait_capture(ping);
        // BUG: refills ping (should be pong) before processing it.
        start_capture(ping);
        process(ping);
        swap ping, pong;
        n = n + 1;
    }
    wait_capture(ping);
}
