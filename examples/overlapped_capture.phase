// v1.1 example: domain changes in function signatures.
//
// A DMA capture is started by one call and finished by another, with CPU
// work in between -- the overlap that is the whole point of DMA. That
// shape needs a function that hands a buffer *to* the hardware and one
// that takes it *back*, which v1.0 signatures couldn't express (a
// parameter had to leave a function in the domain it arrived in).
//
// `@FROM -> @TO` on a parameter declares the change:
//
//   start_capture  @RAM -> @DMA   the transfer is in flight after the call
//   wait_capture   @DMA -> @RAM   the buffer is CPU-visible after the call
//
// The checker tracks `frame` through both calls: touching it between them
// is the classic use-before-sync bug and is rejected (see
// bug_gallery/read_while_capture_in_flight.phase).

entity Sample : @RAM {
    value: f32
}

// Trusted C: program the DMA engine to fill `dst`, and return immediately.
extern fn start_capture(dst: buffer<Sample, 256> @RAM -> @DMA);

extern fn make_window(w: write buffer<Sample, 256> @RAM);
extern fn apply_window(x: write buffer<Sample, 256> @RAM, w: read buffer<Sample, 256> @RAM);
extern fn report(x: read buffer<Sample, 256> @RAM);

// A PHASE helper: the checker verifies its body really does leave `b` in
// @RAM on every path, as the signature promises.
fn wait_capture(b: buffer<Sample, 256> @DMA -> @RAM) {
    sync(b);
}

fn main() {
    buffer<Sample, 256> frame @RAM;
    buffer<Sample, 256> window @RAM;

    start_capture(frame);    // frame: @RAM -> @DMA
    make_window(window);     // CPU work, overlapping the transfer
    wait_capture(frame);     // frame: @DMA -> @RAM

    apply_window(frame, window);
    report(frame);
}
